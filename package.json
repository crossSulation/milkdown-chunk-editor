{
  "name": "milkdown-chunk-editor",
  "version": "0.1.0",
  "description": "Rich-text editor for large documents on Milkdown: splits by heading and virtualizes the viewport, mounting editor instances only for the visible region",
  "keywords": [
    "milkdown",
    "prosemirror",
    "editor",
    "markdown",
    "richtext",
    "virtualization",
    "chunk",
    "large-document",
    "chunked-editor",
    "virtual-scroll"
  ],
  "license": "MIT",
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./style.css": "./dist/style.css",
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "README.en.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/crossSulation/milkdown-chunk-editor.git"
  },
  "homepage": "https://github.com/crossSulation/milkdown-chunk-editor#readme",
  "bugs": {
    "url": "https://github.com/crossSulation/milkdown-chunk-editor/issues"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test test/split.test.ts test/virtual-layout.test.ts test/layout-fenwick.test.ts test/e2e.test.ts test/perf.test.ts test/recycle.test.ts test/recycle-e2e.test.ts",
    "test:bench": "tsx test/benchmark.test.ts",
    "test:layout": "tsx scripts/layout-bench.ts",
    "test:browser": "npm run build && node scripts/browser-check.mjs",
    "test:recycle": "npm run build && node scripts/recycle-browser-check.mjs",
    "test:layout-compare": "npm run build && node scripts/layout-compare.mjs",
    "prepublishOnly": "npm run typecheck && npm run test && npm run build"
  },
  "peerDependencies": {
    "@milkdown/kit": "^7.22.3"
  },
  "peerDependenciesMeta": {
    "@milkdown/kit": {
      "optional": false
    }
  },
  "devDependencies": {
    "@milkdown/kit": "^7.22.3",
    "@types/node": "^22.0.0",
    "happy-dom": "^21.0.4",
    "playwright": "^1.64.1",
    "tsup": "^8.3.5",
    "tsx": "^4.23.15",
    "typescript": "^5.6.3"
  }
}
